# LibreLinkUp-Zugang (dein EIGENER Follower-Account, nicht der deiner Freundin).
# Sie muss dich in der Libre-App unter "Verbundene Apps > LibreLinkUp" einladen.
LLU_EMAIL=du@example.com
LLU_PASSWORD=geheim
# DE, EU, EU2 (UK), US, AE, AP, AU, CA, JP, FR, LA, RU. Wird sonst automatisch per Redirect erkannt.
LLU_REGION=DE
# Nur bei mehreren verbundenen Personen: patientId (siehe /api/patients)
LLU_PATIENT_ID=
# Anzeigeeinheit: mgdl oder mmol
UNIT=mgdl
# Abfrageintervall in Sekunden (mindestens 30)
POLL_SECONDS=60
# Server
HOST=127.0.0.1
PORT=3000
# Optional: Basic-Auth, empfohlen sobald HOST nicht 127.0.0.1 ist
DASH_USER=
DASH_PASS=
# 1 = Demo-Daten ohne Zugangsdaten
DEMO=0
